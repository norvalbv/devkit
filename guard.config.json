{
  "scanRoots": ["cli", "gate-engine"],
  "sourceExtensions": ["mts"],
  "fanoutCap": 12,
  "indexPath": ".search-code/index.db",
  "//review-models": "sc-2107: devkit's own installs run the benched winner (sol judges, 400-LOC correctness chunks). Requires the codex CLI (GUARD_CODEX_BIN pin supported); rollback = delete these three keys or set the GUARD_* env vars. Package DEFAULTS stay claude-era until sc-2054 parity lands.",
  "review": {
    "model": "gpt-5.6-sol",
    "correctnessModel": "gpt-5.6-sol",
    "correctnessChunkLoc": 400,
    "backendRoots": ["cli", "gate-engine"],
    "frontendRoots": [],
    "trustBoundaries": "devkit is a CLI + portable gate-engine, not a hosted app — no server/client split. Its trust model is W-3: devkit ships inside the consumer's node_modules and EXECUTES in a repo it does not own, so every path it resolves must be consumer-cwd-relative, never __dirname, and synced assets (skills/agents/gate scripts) must read layout from the consumer's guard.config.json, never hardcode a stack's directory tree."
  },
  "structure": {
    "trees": [
      {
        "name": "cli",
        "root": "cli",
        "sourceExtensions": ["mts"],
        "entryAllowlist": ["index.mts"],
        "libDomains": {
          "lib": ["doctor", "generate", "guard", "help", "husky", "install", "ship"]
        },
        "grammar": {
          "files": ["index.mts"],
          "folders": {
            "commands": {
              "files": ["{kebab}", "{kebab_test}"],
              "recurse": "kebabModule"
            },
            "lib": {
              "files": ["{kebab}", "{kebab_test}"],
              "domainGate": "lib",
              "recurse": "kebabModule"
            }
          },
          "rules": {
            "kebabModule": {
              "folderName": "{kebab_dir}",
              "files": ["{kebab}", "{kebab_test}", "{json}"],
              "recurse": "kebabModule"
            }
          }
        }
      },
      {
        "name": "gate-engine",
        "root": "gate-engine",
        "sourceExtensions": ["mts"],
        "entryAllowlist": ["config.mts", "devkit-version.mts"],
        "ignoredDirs": ["eval"],
        "libDomains": {
          "@root": [
            "co-occurrence",
            "comment-firewall",
            "coverage",
            "decisions",
            "deterministic",
            "edge-cases",
            "fallow",
            "judge",
            "prefix-cache",
            "prior-art",
            "qavis-advisory",
            "ratchets",
            "review",
            "search-tool",
            "sentry",
            "structure",
            "critique"
          ]
        },
        "grammar": {
          "files": ["config.mts"],
          "domainGate": "@root",
          "recurse": "engineModule",
          "rules": {
            "engineModule": {
              "folderName": "{kebab_dir}",
              "files": ["{kebab}", "{kebab_test}", "{json}"],
              "recurse": "engineModule"
            }
          }
        }
      }
    ],
    "walls": []
  },
  "//maxLines": "Raw line cap per source file (guard-size ratchet enforces it; existing giants grandfathered shrink-only). 0 = off. Per-FUNCTION caps need a parser — not yet.",
  "maxLines": 500,
  "//maxTestLines": "Loose raw line cap per test file; existing oversized tests are grandfathered shrink-only. 0 = off.",
  "maxTestLines": 2000
}
