{
  "scanRoots": ["cli", "gate-engine"],
  "sourceExtensions": ["mts"],
  "fanoutCap": 12,
  "extraGates": { "git-pathspec": "node scripts/git-pathspec-check.mts" },
  "indexPath": ".search-code/index.db",
  "//generated": "Paths ship's three-way staging abort points at a generator instead of a hand-merge (sc-2770). .devkit/*-manifest.json are built-in defaults.",
  "generated": [{ "glob": "dist/**", "command": "bun run build" }],
  "//comments": "devkit is open source: a comment citing a private Shortcut ticket, an autonomous report id or a decision record means nothing to an outside reader, so guard-comments blocks changed comments that do.",
  "comments": {
    "forbiddenRefs": ["\\bsc-\\d+\\b", "\\breport-[0-9a-f]{6,}\\b"],
    "forbidDecisionRefs": true
  },
  "//research": "Sibling clones the prior-art agent may read (agents/prior-art.md). Unresolved entries are skipped, so a clone without them stays valid.",
  "research": {
    "referenceCheckouts": ["../bug-mcp", "../claude-usage-dashboard", "../frink", "../qavis"]
  },
  "review": {
    "backendRoots": ["cli", "gate-engine"],
    "frontendRoots": [],
    "paths": {
      "include": ["**"],
      "exclude": [
        ".agents/**",
        ".claude/**",
        ".codex/**",
        ".cursor/**",
        ".devkit/**",
        ".env*",
        "**/.env*",
        "node_modules/**",
        "**/node_modules/**",
        "dist/**",
        "**/dist/**",
        "coverage/**",
        "*.lock",
        "**/*.lock"
      ]
    },
    "trustBoundaries": "devkit is a CLI + portable gate-engine, not a hosted app — no server/client split. Its trust model is W-3: devkit ships inside the consumer's node_modules and EXECUTES in a repo it does not own, so every path it resolves must be consumer-cwd-relative, never __dirname, and synced assets (skills/agents/gate scripts) must read layout from the consumer's guard.config.json, never hardcode a stack's directory tree."
  },
  "structure": {
    "trees": [
      {
        "name": "cli",
        "root": "cli",
        "sourceExtensions": ["mts"],
        "entryAllowlist": ["index.mts"],
        "libDomains": {
          "lib": [
            "baseline-status",
            "doctor",
            "generate",
            "guard",
            "help",
            "husky",
            "install",
            "move",
            "ship"
          ]
        },
        "grammar": {
          "files": ["index.mts"],
          "folders": {
            "commands": {
              "files": ["{kebab}", "{kebab_test}"],
              "recurse": "kebabModule"
            },
            "lib": {
              "files": ["{kebab}", "{kebab_test}"],
              "domainGate": "lib",
              "recurse": "kebabModule"
            }
          },
          "rules": {
            "kebabModule": {
              "folderName": "{kebab_dir}",
              "files": ["{kebab}", "{kebab_test}", "{json}"],
              "recurse": "kebabModule"
            }
          }
        }
      },
      {
        "name": "gate-engine",
        "root": "gate-engine",
        "sourceExtensions": ["mts"],
        "entryAllowlist": [
          "config-json.mts",
          "config.mts",
          "devkit-version.mts",
          "overlay-mode.mts"
        ],
        "ignoredDirs": ["eval"],
        "libDomains": {
          "@root": [
            "co-occurrence",
            "comment-firewall",
            "coverage",
            "decisions",
            "deterministic",
            "edge-cases",
            "fallow",
            "judge",
            "markdown",
            "prefix-cache",
            "prior-art",
            "qavis-advisory",
            "ratchets",
            "review",
            "search-tool",
            "sentry",
            "structure",
            "critique"
          ]
        },
        "grammar": {
          "files": ["config-json.mts", "config.mts"],
          "domainGate": "@root",
          "recurse": "engineModule",
          "rules": {
            "engineModule": {
              "folderName": "{kebab_dir}",
              "files": ["{kebab}", "{kebab_test}", "{json}"],
              "recurse": "engineModule"
            }
          }
        }
      }
    ],
    "walls": []
  },
  "//maxLines": "Raw line cap per source file (guard-size ratchet enforces it; existing giants grandfathered shrink-only). 0 = off. Per-FUNCTION caps need a parser — not yet.",
  "maxLines": 500,
  "//maxTestLines": "Loose raw line cap per test file; existing oversized tests are grandfathered shrink-only. 0 = off.",
  "maxTestLines": 2000
}
