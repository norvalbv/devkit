{
  "scanRoots": ["cli", "gate-engine"],
  "sourceExtensions": ["mts"],
  "fanoutCap": 12,
  "indexPath": ".search-code/index.db",
  "review": {
    "backendRoots": ["cli", "gate-engine"],
    "frontendRoots": [],
    "paths": {
      "include": ["**"],
      "exclude": [
        ".agents/**",
        ".claude/**",
        ".codex/**",
        ".cursor/**",
        ".devkit/**",
        ".env*",
        "**/.env*",
        "node_modules/**",
        "**/node_modules/**",
        "dist/**",
        "**/dist/**",
        "coverage/**",
        "**/coverage/**",
        "*.lock",
        "**/*.lock"
      ]
    },
    "trustBoundaries": "devkit is a CLI + portable gate-engine, not a hosted app — no server/client split. Its trust model is W-3: devkit ships inside the consumer's node_modules and EXECUTES in a repo it does not own, so every path it resolves must be consumer-cwd-relative, never __dirname, and synced assets (skills/agents/gate scripts) must read layout from the consumer's guard.config.json, never hardcode a stack's directory tree."
  },
  "structure": {
    "trees": [
      {
        "name": "cli",
        "root": "cli",
        "sourceExtensions": ["mts"],
        "entryAllowlist": ["index.mts"],
        "libDomains": {
          "lib": [
            "baseline-status",
            "doctor",
            "generate",
            "guard",
            "help",
            "husky",
            "install",
            "ship"
          ]
        },
        "grammar": {
          "files": ["index.mts"],
          "folders": {
            "commands": {
              "files": ["{kebab}", "{kebab_test}"],
              "recurse": "kebabModule"
            },
            "lib": {
              "files": ["{kebab}", "{kebab_test}"],
              "domainGate": "lib",
              "recurse": "kebabModule"
            }
          },
          "rules": {
            "kebabModule": {
              "folderName": "{kebab_dir}",
              "files": ["{kebab}", "{kebab_test}", "{json}"],
              "recurse": "kebabModule"
            }
          }
        }
      },
      {
        "name": "gate-engine",
        "root": "gate-engine",
        "sourceExtensions": ["mts"],
        "entryAllowlist": ["config-json.mts", "config.mts", "devkit-version.mts"],
        "ignoredDirs": ["eval"],
        "libDomains": {
          "@root": [
            "co-occurrence",
            "comment-firewall",
            "coverage",
            "decisions",
            "deterministic",
            "edge-cases",
            "fallow",
            "judge",
            "markdown",
            "prefix-cache",
            "prior-art",
            "qavis-advisory",
            "ratchets",
            "review",
            "search-tool",
            "sentry",
            "structure",
            "critique"
          ]
        },
        "grammar": {
          "files": ["config-json.mts", "config.mts"],
          "domainGate": "@root",
          "recurse": "engineModule",
          "rules": {
            "engineModule": {
              "folderName": "{kebab_dir}",
              "files": ["{kebab}", "{kebab_test}", "{json}"],
              "recurse": "engineModule"
            }
          }
        }
      }
    ],
    "walls": []
  },
  "//maxLines": "Non-comment physical line cap per source file (guard-size ratchet enforces it; existing giants grandfathered shrink-only). Blank and mixed code/comment lines count. 0 = off. Per-FUNCTION caps need a parser — not yet.",
  "maxLines": 500,
  "//maxTestLines": "Loose non-comment physical line cap per test file; blank and mixed code/comment lines count. Existing oversized tests are grandfathered shrink-only. 0 = off.",
  "maxTestLines": 2000
}
