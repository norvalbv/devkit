{
  "plugins": [
    "eslint",
    "typescript",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "deny",
    "perf": "deny",
    "suspicious": "deny"
  },
  "overrides": [
    {
      "files": [
        ".devkit/anti-slop/probe.ts",
        "**/devkit-anti-slop-integration-probe.ts"
      ],
      "globals": {
        "__DEVKIT_OXC_BASE_1_78_0_MANAGED_PROBE__": "readonly"
      }
    }
  ],
  "rules": {
    "react/rules-of-hooks": "deny"
  },
  "extends": [
    "../anti-slop/oxlint.json"
  ]
}
