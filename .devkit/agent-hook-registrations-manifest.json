{
  "schemaVersion": 1,
  "kind": "agent_hook_registration_ownership",
  "entries": [
    {
      "registrationId": "adhd:prompt-anchor",
      "ownerId": "adhd",
      "provider": "claude",
      "installScope": "shared",
      "destinationRel": ".claude/settings.json",
      "native": {
        "event": "UserPromptSubmit",
        "matcher": "",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/adhd-prompt-anchor.mjs\""
      }
    },
    {
      "registrationId": "adhd:session-start",
      "ownerId": "adhd",
      "provider": "claude",
      "installScope": "shared",
      "destinationRel": ".claude/settings.json",
      "native": {
        "event": "SessionStart",
        "matcher": "startup|resume|clear|compact",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/adhd-session-start.mjs\""
      }
    },
    {
      "registrationId": "decisions:pre-edit",
      "ownerId": "decisions",
      "provider": "claude",
      "installScope": "shared",
      "destinationRel": ".claude/settings.json",
      "native": {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit|Delete",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/decision-edit-guard.mjs\""
      }
    },
    {
      "registrationId": "decisions:scope-brief",
      "ownerId": "decisions",
      "provider": "claude",
      "installScope": "shared",
      "destinationRel": ".claude/settings.json",
      "native": {
        "event": "PreToolUse",
        "matcher": "Edit|Write|MultiEdit",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/decision-scope-brief.mjs\""
      }
    },
    {
      "registrationId": "prior-art-gate:post-task",
      "ownerId": "priorArtGate",
      "provider": "claude",
      "installScope": "shared",
      "destinationRel": ".claude/settings.json",
      "native": {
        "event": "PostToolUse",
        "matcher": "Task|Agent",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prior-art-gate.mjs\""
      }
    },
    {
      "registrationId": "prior-art-gate:pre-plan",
      "ownerId": "priorArtGate",
      "provider": "claude",
      "installScope": "shared",
      "destinationRel": ".claude/settings.json",
      "native": {
        "event": "PreToolUse",
        "matcher": "ExitPlanMode|Task|Agent",
        "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/prior-art-gate.mjs\""
      }
    },
    {
      "registrationId": "decisions:pre-edit",
      "ownerId": "decisions",
      "provider": "cursor",
      "installScope": "shared",
      "destinationRel": ".cursor/hooks.json",
      "native": {
        "event": "preToolUse",
        "matcher": "Write|Delete",
        "command": ".cursor/hooks/decision-edit-guard.mjs"
      }
    },
    {
      "registrationId": "decisions:scope-brief",
      "ownerId": "decisions",
      "provider": "cursor",
      "installScope": "shared",
      "destinationRel": ".cursor/hooks.json",
      "native": {
        "event": "preToolUse",
        "matcher": "Write",
        "command": ".cursor/hooks/decision-scope-brief.mjs"
      }
    }
  ]
}
