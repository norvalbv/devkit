+++ b/gate-engine/decisions/write/retarget-carry.mts
@@ -0,0 +1,145 @@
+/**
+ * What a re-target does with the live notes under the Target it buries.
+ *
+ * Every reader of an axis serves the newest Target and the notes under it, so a re-target silently
+ * retires every note left under the outgoing block. The writer answers each one: `--carry` re-records
+ * it under the new Target, `--drop` leaves it as history. There is no default and no carry-all.
+ * Rescope notes are never listed: carrying one would re-scope the new Target behind its `--scope`.
+ */
+import { type AddOptions, currentTarget, renderNote } from '../decision-format.mts';
+import { sections } from '../recall/markdown.mts';
+import { axisNotes, CARRIED_SUFFIX_RE, carriedFrom } from '../recall/note-relations.mts';
+import { SCOPE_NOTE_RE } from '../recall/retrieval.mts';
+
+export interface CarryAnswers {
+  carry?: string;
+  drop?: string;
+}
+
+export interface OutgoingNote {
+  id: string;
+  /** As written on disk, including any `(carried from …)` suffix. */
+  text: string;
+  /** The id the note was first written under: its own, or the one a carry suffix names. */
+  origin: string;
+}
+
+const ID_SEPARATOR_RE = /[\s,]+/;
+const TARGET_HEAD = '## Target · ';
+
+function ids(raw: string | undefined): string[] {
+  return [...new Set((raw ?? '').split(ID_SEPARATOR_RE).filter(Boolean))];
+}
+
+/** Index into `sections(body)` of every `## Target ·` block, oldest first. */
+function targetSections(body: string): number[] {
+  return sections(body).flatMap((s, i) =>
+    s.depth === 2 && s.heading.startsWith(TARGET_HEAD) ? [i] : [],
+  );
+}
+
+function asOutgoing(notes: ReturnType<typeof axisNotes>): OutgoingNote[] {
+  return notes
+    .filter((n) => !SCOPE_NOTE_RE.test(n.text))
+    .map((n) => ({ id: n.id, text: n.text, origin: carriedFrom(n.text) ?? n.id }));
+}
+
+/** The live, non-rescope notes under the newest Target: what a re-target of `body` would bury. */
+export function outgoingNotes(body: string): OutgoingNote[] {
+  const last = targetSections(body).at(-1);
+  return asOutgoing(axisNotes(body).filter((n) => n.sectionIndex === last));
+}
+
+/** The re-target listing on stderr. It is also the prompt the writer-replay experiment sends. */
+export function formatPending(slug: string, notes: OutgoingNote[]): string {
+  return [
+    `Axis "${slug}": ${notes.length} live note(s) under the outgoing Target have no --carry or --drop answer.`,
+    'Readers of the newest Target do not see notes left under an older Target.',
+    'Answer every id below with --carry "<ids>" or --drop "<ids>". There is no default.',
+    '  --carry  the note still binds the code: it is re-recorded after the new Target, citing its id.',
+    '  --drop   the note is history (what was built or measured), or the new Ruling replaces or retires it.',
+    '',
+    ...notes.map((n) => `  ${n.id} — ${n.text}`),
+    '',
+    'A note that changes the rule: restate it in --ruling, then drop it.',
+    `A Target on a different sub-topic belongs on its own axis: guard-decisions add <new-slug> --target … --new`,
+    "Rescope notes are not listed: the new Target's --scope is its whole Scope.",
+    `Carry after writing: guard-decisions add ${slug} --carry "<ids>"`,
+    'This release still writes an unanswered re-target; the next minor release refuses it.',
+  ].join('\n');
+}
+
+function carriedLine(note: OutgoingNote, date: string): string {
+  return renderNote(
+    date,
+    `${note.text.replace(CARRIED_SUFFIX_RE, '')} (carried from ${note.origin})`,
+  );
+}
+
+function pick(listed: OutgoingNote[], body: string, wanted: string[], where: string) {
+  return wanted.map((id) => {
+    const note = listed.find((n) => n.id === id);
+    if (note) return note;
+    const scoped = axisNotes(body).some((n) => n.id === id && SCOPE_NOTE_RE.test(n.text));
+    throw new Error(
+      scoped
+        ? `${id} is a rescope note. Scope is never carried — put the globs in the new Target's --scope.`
+        : `${id} is not a note under ${where}. \`guard-decisions show <slug>\` lists note ids.`,
+    );
+  });
+}
+
+/**
+ * Validate the answers to a re-target of `body` and return the carried lines to write after the
+ * new Target. Throws before anything is written; prints the listing for every unanswered note.
+ */
+export function retargetCarry(
+  slug: string,
+  body: string,
+  o: AddOptions & CarryAnswers,
+  date: string,
+): string[] {
+  // Re-target guard: a Target moves only on an evidence-state change, never on impl pain. Trimmed
+  // so the CLI cannot write a hollow field that integrity/checks.mts would then flag as missing.
+  if (currentTarget(body) && !o.evidenceChange?.trim()) {
+    console.error(
+      `Axis "${slug}" already has a Target. An implementation change is a NOTE — drop --target:\n` +
+        `  guard-decisions add ${slug} --note "<what converged>"\n` +
+        'Re-target ONLY on an evidence-state change — pass --evidence-change "<what shifted>".',
+    );
+    process.exit(1);
+  }
+  const listed = outgoingNotes(body);
+  const [carry, drop] = [ids(o.carry), ids(o.drop)];
+  const both = carry.filter((id) => drop.includes(id));
+  if (both.length) throw new Error(`${both.join(', ')} named in both --carry and --drop.`);
+  const carried = pick(listed, body, carry, 'the outgoing Target');
+  pick(listed, body, drop, 'the outgoing Target');
+  const unanswered = listed.filter((n) => !carry.includes(n.id) && !drop.includes(n.id));
+  if (unanswered.length) console.error(formatPending(slug, unanswered));
+  return carried.map((n) => carriedLine(n, date));
+}
+
+/** The append-only answer after a re-target: carry notes from a superseded Target to the current one. */
+export function carryLater(body: string, o: AddOptions & CarryAnswers, date: string): string[] {
+  if (o.drop !== undefined)
+    throw new Error(
+      '--drop answers a re-target: pass it with --target. Notes left behind need no command.',
+    );
+  if (o.note !== undefined)
+    throw new Error('--carry and --note write separate entries: run them as two commands.');
+  const wanted = ids(o.carry);
+  if (!wanted.length) throw new Error('--carry needs the note ids to carry.');
+  const all = axisNotes(body);
+  const blocks = targetSections(body);
+  const current = blocks.at(-1);
+  const superseded = asOutgoing(
+    all.filter((n) => n.sectionIndex !== current && blocks.includes(n.sectionIndex)),
+  );
+  const already = new Set(outgoingNotes(body).map((n) => n.origin));
+  return pick(superseded, body, wanted, 'a superseded Target').map((n) => {
+    if (already.has(n.origin))
+      throw new Error(`${n.origin} is already carried under the current Target.`);
+    return carriedLine(n, date);
+  });
+}
